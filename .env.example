# Dev: leave EMPTY so the app calls /api on its own origin and Nuxt proxies to
# the backend (routeRules in nuxt.config.ts) — keeps the refresh cookie
# first-party. Set to the real backend origin in production (same-site there).
NUXT_PUBLIC_API_BASE=

# ── Analytics (Mixpanel + GA4) ───────────────────────────────────────────────
# A hard no-op unless ENABLED=true AND a Mixpanel token is set. Tracking starts
# on the first pageview (no consent gate). See docs/analytics-implementation-plan.md.
#
# Use SEPARATE Mixpanel projects per environment so test traffic never pollutes
# production metrics: put the "Mnemio (dev)" project token here / in your local
# .env, and the "Mnemio (prod)" token in the production host env only.
NUXT_PUBLIC_ANALYTICS_ENABLED=false
NUXT_PUBLIC_MIXPANEL_TOKEN=
# Mixpanel ingestion host — MUST match the project's data residency. The Mnemio
# projects are EU, so this defaults to https://api-eu.mixpanel.com. Set to
# https://api.mixpanel.com only for a US-residency project.
NUXT_PUBLIC_MIXPANEL_API_HOST=https://api-eu.mixpanel.com
NUXT_PUBLIC_GA4_ID=
# Log every tracked event to the console ("[Mixpanel] Tracked …"). The dev server
# always logs; set this true on a deployed env (e.g. the dev/staging deploy) to
# verify tracking there. Leave false in real production.
NUXT_PUBLIC_ANALYTICS_DEBUG=false
# 0..1 sampling for the high-volume per-card event (0 = off; sessions are
# aggregated anyway). Leave at 0 unless running a deep-dive study.
NUXT_PUBLIC_ANALYTICS_CARD_SAMPLING=0
